---
// The project's page: what it does, where it reads, how it keeps to the machine.

import { AMO, chats, DOCS, planned, REPO, shipped } from "../chats.js";
import Page from "../layouts/Page.astro";

const list = chats();
---

<Page
	title="save-my-chat: your AI chats, saved on your machine"
	description="A Firefox extension that saves a conversation from an AI chat webapp on your own machine, as Markdown or JSON, in one clear format. Nothing is sent anywhere."
>
	<div class="site">
	<header>
		<img class="banner" src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}media/banner.webp`} alt="save-my-chat: export AI chats to Markdown or JSON - a blue cat filing chats into a local disk" width="1280" height="640" />
		<p class="name">save-my-chat</p>
		<h1>Your AI chats, saved on your own machine.</h1>
		<p class="lead">
			A Firefox extension that takes a conversation out of a chat webapp and saves it as Markdown or JSON, in one format
			that reads the same whichever service it came from. Nothing is sent anywhere.
		</p>
		<p class="actions">
			<a class="button" href={AMO}>Add to Firefox</a>
			<a href={`${DOCS}manual/install/`}>How to install it</a>
		</p>
		<p class="small">
			On addons.mozilla.org; each release reaches it after Mozilla's review, and is on{" "}
			<a href={`${REPO}/releases`}>GitHub</a> at once.
		</p>
	</header>

	<main>
		<section>
			<h2>How it works</h2>
			<ol class="steps">
				<li><strong>Open a conversation</strong> in one of the webapps below.</li>
				<li><strong>Click the toolbar button.</strong> It says which reader sees the page and how many messages it found.</li>
				<li><strong>Choose Markdown or JSON.</strong> The file lands in your downloads, and a copy in the extension's library.</li>
			</ol>
			<p>
				<a href="demo/">Try the popup and the options here</a>, with made-up chats, or{" "}
				<a href="viewer/">read a chat you saved</a> in the viewer.
			</p>
		</section>

		<section>
			<h2>Webapps it reads</h2>
			<table class="readers">
				<thead><tr><th>Webapp</th><th>A conversation's address</th><th>State</th></tr></thead>
				<tbody>
					{
						shipped(list).map((r) => (
							<tr>
								<td>{r.name}</td>
								<td>{r.addresses.map((a, i) => <>{i > 0 && <br />}<code>{a}</code></>)}</td>
								<td>{r.state}</td>
							</tr>
						))
					}
				</tbody>
			</table>
			<p class="small">
				Planned: {planned(list)}. A webapp changes its page now and then; when a reader misses something, its report in the
				popup shows what it saw, and your own selectors fix it without waiting for a release.
			</p>
		</section>

		<section>
			<h2>Nothing leaves your machine</h2>
			<p>
				The extension reads only the page you have open, and only when you click. It writes files through Firefox's
				downloads, and makes no network requests of its own: no telemetry, no accounts, no remote code.{" "}
				<a href={`${DOCS}manual/privacy/`}>What it reads and writes</a>.
			</p>
		</section>

		<section>
			<h2>Read on</h2>
			<ul class="links">
				<li><a href={DOCS}>The manual</a>: installing, saving, when a reader misses something, privacy</li>
				<li><a href={`${DOCS}guides/readers/`}>How a reader is written</a> and <a href={`${DOCS}guides/format/`}>the unified format</a></li>
				<li><a href={`${REPO}/wiki`}>The wiki</a>: the devlog, the changelog, the almanac of problems solved; in English and Polish</li>
				<li><a href={`${REPO}/discussions`}>Discussions</a>: news, ideas, questions</li>
				<li><a href={REPO}>The code on GitHub</a>, under the Mozilla Public License 2.0</li>
			</ul>
		</section>
	</main>
	</div>
</Page>

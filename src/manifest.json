{
	"manifest_version": 3,
	"name": "save-my-chat",
	"version": "0.1.45",
	"description": "Saves a conversation from an AI chat webapp on your machine, in one clear unified format.",
	"background": {
		"scripts": ["core/kit.js", "core/markdown.js", "core/readers.js", "background/main.js"]
	},
	"action": {
		"default_popup": "popup/popup.html",
		"default_title": "Save this chat"
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"permissions": ["scripting", "storage", "downloads"],
	"optional_permissions": ["userScripts"],
	"host_permissions": ["https://www.google.com/*", "https://github.com/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "save-my-chat@radiokociamuzyka.pl",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	}
}

{
	"manifest_version": 3,
	"name": "save-my-chat",
	"version": "0.7.29",
	"description": "Saves a conversation from an AI chat webapp on your machine, in one clear unified format.",
	"background": {
		"scripts": ["core/kit.js", "core/markdown.js", "core/readers.js", "core/library.js", "background/main.js"]
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"96": "icons/icon-96.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		},
		"default_popup": "popup/popup.html",
		"default_title": "Save this chat"
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"permissions": ["scripting", "storage", "downloads", "menus"],
	"optional_permissions": ["userScripts"],
	"optional_host_permissions": [
		"https://api.github.com/*",
		"https://chatgpt.com/*",
		"https://claude.ai/*",
		"https://gemini.google.com/*",
		"https://chat.deepseek.com/*",
		"https://grok.com/*",
		"https://x.com/*"
	],
	"host_permissions": ["https://www.google.com/*", "https://github.com/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "save-my-chat@radiokociamuzyka.pl",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": ["none"],
				"optional": ["websiteContent", "personalCommunications"]
			}
		}
	}
}
